<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's helper processes (renderer, GPU, plugin) inherit the parent's
       sandbox rather than declaring their own. Signing them with the full
       entitlement set instead is what breaks Chromium's Mach port rendezvous. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
