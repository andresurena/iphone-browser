{
  "name": "iphone-browser",
  "version": "0.1.0",
  "description": "A native Mac app that behaves like the browser on your phone \u2014 a real Chromium browser inside an iPhone or Pixel frame.",
  "main": "src/main.js",
  "author": "Andr\u00e9s Ure\u00f1a",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "build": "electron-builder --mac --universal",
    "dist": "npm run icon && npm run build",
    "spike": "electron-builder --mac mas-dev -c.appId=com.andresurena.responsivephonebrowser -c.productName=\"Responsive Phone Browser\"",
    "mas": "npm run icon && electron-builder --mac mas -c.appId=com.andresurena.responsivephonebrowser -c.productName=\"Responsive Phone Browser\""
  },
  "build": {
    "appId": "com.andresurena.iphonebrowser",
    "productName": "iPhone Browser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "mas": {
      "category": "public.app-category.developer-tools",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "icon": "build/icon.icns"
    },
    "masDev": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "type": "development",
      "provisioningProfile": "build/Responsive_Phone_Browser_Mac_Development.provisionprofile",
      "identity": "Apple Development: Andres Urena (DNFZ36X536)"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "electron",
    "mac",
    "ios",
    "android",
    "iphone",
    "pixel",
    "responsive",
    "mobile",
    "preview",
    "devtools",
    "emulator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andresurena/iphone-browser.git"
  }
}
